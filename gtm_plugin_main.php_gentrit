function isImage($url){
	$temp=explode(".",$url);
	return in_array(
		strtoupper(end($temp)),
		array('JPG','PNG','GIF','TIFF','RAW')
	);
}


/**
 * Decides if a file is a video based on the file name
 * @param string $url the location of the file
 * @return boolean 
 */
function isVideo($url){
	$temp=explode(".",$url);
	return in_array(
		strtoupper(end($temp)),
		array(
			'WEBM',
			'MPG', 'MP2', 'MPEG', 'MPE', 'MPV',
			'OGG',
			'MP4', 'M4P', 'M4V',
			'AVI', 'WMV',
			'MOV', 'QT',
			'FLV', 'SWF',
		));
}

