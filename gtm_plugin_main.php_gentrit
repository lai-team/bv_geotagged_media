add_filter('wp_handle_upload_prefilter','bv_handle_upload_prefilter',10,1);
function bv_handle_upload_prefilter($uploaded_file)
{
	$user_id=get_current_user_id();
	$plan = bv_get_required_level_status($user_id, get_user_blog_id($user_id))?'premium':'basic';
	$maxFileUploadLocal =$GLOBALS['maxFileUpload'][$plan][explode("/",$uploaded_file['type'])[0]];
	if( $uploaded_file['size'] > $maxFileUploadLocal )
		return array("error"=>'File size is too large: '. number_format($mediaFile['size']/1024/1024,2,'.','').'Mb. Maximum is '.$maxFileUploadLocal. number_format($maxFileUploadLocal/1024/1024,2,'.','') .'Mb');
	else{
		return $uploaded_file;
	}
}
function get_image_tags($url,$model){
	$client = new ClarifaiClient($GLOBALS['CLARIFAI_ID']);

	global $BAD_TAGS;
	$response = $client->publicModels()->customModel($model['id'])->predict(
		new ClarifaiFileImage(file_get_contents($url)))
		    ->executeSync();

	if ($response->isSuccessful()) {
		/** @var ClarifaiOutput $output */
		$output = $response->get();
		$returnArr= array();

		/** @var Concept $concept */
		foreach ($output->data() as $concept) {
			if( ! in_array($concept->name(),$BAD_TAGS ) && $concept->value()>$model['threshold'])
				$returnArr+=array($concept->name() => $concept->value());
		}
		return array_slice($returnArr,0,$model['max_tag_number']);
	}else {
		// echo "Response is not successful. Reason: \n";
		error_log(print_r( $response->status()->description() . "\n",true));
		error_log(print_r( $response->status()->errorDetails() . "\n",true));
		// echo "Status code: " . $response->status()->statusCode();
		return $response->status()->description();
	}
}

/**
 * Generates tags for a given video 
 * @param string $url the location of the video
 * @param array $model CLARIFAI_ID and max_tag_number
 * @return array List of tags generated from the video
 */
function get_video_tags($url,$model){
	$client = new ClarifaiClient($GLOBALS['CLARIFAI_ID']);

	$response = $client->publicModels()->customModel($model['id'])->predict(
		new ClarifaiURLVideo($url))
		    ->withSampleMs(10000)
		    ->executeSync();

	if ($response->isSuccessful()) {
		/** @var ClarifaiOutput $output */
		$frames= json_decode($response->rawBody())->outputs[0]->data->frames;
		$returnArr= array();
		/** @var Concept $concept */
		foreach($frames as $frame) {
			foreach($frame->data->concepts as $concept){
				if($returnArr[$concept->name] && $concept->value > $model['threshold']){
					$returnArr[$concept->name] += $concept->value;
				}
				elseif( $concept->value > $model['threshold'] )
					$returnArr[$concept->name] = $concept->value;
			}
		}
		arsort($returnArr);
		return(array_slice($returnArr,0,$model['max_tag_number']));
	}
	else {
		// echo "Response is not successful. Reason: \n";
		// echo $response->status()->description() . "\n";
		// echo $response->status()->errorDetails() . "\n";
		// echo "Status code: " . $response->status()->statusCode();
		return $response->status()->description();
	}
}
/**
 * Reads the exif data of an image 
 * @param string $file the location of the image
 * @return array longitude, latitude and datetime created
 */
function read_gps_location($file){
	$info = exif_read_data($file);
	// print_r($info);
	if (isset($info['GPSLatitude']) && isset($info['GPSLongitude']) &&
		isset($info['GPSLatitudeRef']) && isset($info['GPSLongitudeRef']) &&
		in_array($info['GPSLatitudeRef'], array('E','W','N','S')) && in_array($info['GPSLongitudeRef'], array('E','W','N','S'))) {

		$GPSLatitudeRef  = strtolower(trim($info['GPSLatitudeRef']));
		$GPSLongitudeRef = strtolower(trim($info['GPSLongitudeRef']));

		$lat_degrees_a = explode('/',$info['GPSLatitude'][0]);
		$lat_minutes_a = explode('/',$info['GPSLatitude'][1]);
		$lat_seconds_a = explode('/',$info['GPSLatitude'][2]);
		$lng_degrees_a = explode('/',$info['GPSLongitude'][0]);
		$lng_minutes_a = explode('/',$info['GPSLongitude'][1]);
		$lng_seconds_a = explode('/',$info['GPSLongitude'][2]);

		$lat_degrees = $lat_degrees_a[0] / $lat_degrees_a[1];
		$lat_minutes = $lat_minutes_a[0] / $lat_minutes_a[1];
		$lat_seconds = $lat_seconds_a[0] / $lat_seconds_a[1];
		$lng_degrees = $lng_degrees_a[0] / $lng_degrees_a[1];
		$lng_minutes = $lng_minutes_a[0] / $lng_minutes_a[1];
		$lng_seconds = $lng_seconds_a[0] / $lng_seconds_a[1];

		$lat = (float) $lat_degrees+((($lat_minutes*60)+($lat_seconds))/3600);
		$lng = (float) $lng_degrees+((($lng_minutes*60)+($lng_seconds))/3600);

		//If the latitude is South, make it negative. 
		//If the longitude is west, make it negative
		$GPSLatitudeRef  == 's' ? $lat *= -1 : '';
		$GPSLongitudeRef == 'w' ? $lng *= -1 : '';

		return array(
			'lat' => $lat,
			'lng' => $lng,
			'datetime' =>$info['DateTimeOriginal']
		);
	}     
	return array(
		'datetime' =>$info['DateTimeOriginal']
	);
	//return false;
}

function bv_scalescore($model,$value,$models=array('general'))
{
	$result=(in_array($model,$models)? max(($value - 0.9 ) * 10,0):  $value * 1 );
	return($result);
}

function bv_attachment($attachment_ID)
{          
	global $current_user;
	get_currentuserinfo();
	$att_url = wp_get_attachment_url( $attachment_ID );
	$exif=read_gps_location($att_url);
	// Adds geospatial data
	if( $exif['lng'] && $exif['lat'] ){
		//update the geom_point of an image
		update_post_meta($attachment_ID, 'geom_point','{"type":"Feature","properties":{},"geometry":{"type":"Point","coordinates":['. $exif['lng'].','. $exif['lat'] .']}}');
		//add_post_meta($attachment_ID, 'geom_point',WP_GeoUtil::point( $exif['lat'], $exif['lng'] ); //to be rewritten
	}
	update_post_meta($attachment_ID,'datetime',$exif['datetime']);


	$TagArr= array();         
	if(isImage($att_url)){
		foreach($GLOBALS['CLARIFAI_MODEL_ID'] as $name => $el){            
		//	$tarray=get_image_tags($att_url,$el);
			foreach ($tarray as $key=>$value){
				$new_value =  bv_scalescore($name,$value);
				if ($new_value > 0.8 ){
					$TagArr+=array($key => $new_value);
				}
			}
			if ( strtolower($name) == 'nsfw' ){
				add_post_meta( $attachment_ID, 'clarifai_nsfw',$tarray[$name] );
			}else{
				add_post_meta( $attachment_ID, 'clarifai_'. $name,$tarray );
			}
			// wp_set_post_tags( $attachment_ID, array_keys(get_image_tags($att_url, $el)), true );
		};
		arsort($TagArr);
	}
	elseif(isVideo($att_url)){
		foreach($GLOBALS['CLARIFAI_MODEL_ID'] as $name => $el){
			add_post_meta( $attachment_ID, 'clarifai_'.$name,get_video_tags($att_url, $el) );
			// wp_set_post_tags( $attachment_ID, array_keys(get_video_tags($att_url, $el)), true );
		};
	}
	//var_error_log($TagArr);
	if( !empty($TagArr)) wp_set_post_tags( $attachment_ID, array_keys($TagArr), true );


}

add_action("add_attachment", 'bv_attachment');

function bv_thumbnailmeta_postmeta($post,$post_obj)
{
	if ( get_post_type($post) != 'post' ) return;
	if( $post_thumbnail_id = get_post_thumbnail_id( $post ) ){
		$datetime=get_post_meta( $post_thumbnail_id, 'datetime',true);
		$geom_point=get_post_meta( $post_thumbnail_id, 'geom_point',true);
		$post_tags=wp_get_post_tags( $post_thumbnail_id );
		// echo "update_post_meta($post,'geom_point',$geom_point)";
		if( isset($datetime) && !empty($datetime) ){
			$my_args = array(
				'ID' => $post,
				'post_date' => $datetime,
				'post_date_gmt' => $datetime
			);

			if ( ! wp_is_post_revision( $post ) ){

				// unhook this function so it doesn't loop infinitely
				remove_action('save_post', 'bv_thumbnailmeta_postmeta');

				// update the post, which calls save_post again
				wp_update_post( $my_args );
				if ( isset($geom_point) && !empty($geom_point)){
					update_post_meta($post,'geom_point',$geom_point);
				}else{
					delete_post_meta($post,'geom_point');
				}
				if ( empty(wp_get_post_tags($post)) && isset($post_tags) && !empty($post_tags)){
					//		wp_set_post_tags( $post, $post_tags,true);
				}
				//bv_update_bothline1($post); not needed. Function is called via another hook with lower priority.

				// re-hook this function
				add_action('save_post', 'bv_thumbnailmeta_postmeta');
			}
		/*
		var_error_log('datetime ' . $datetime . ' of post ' . $post);
			$post_obj->post_date = $datetime;
			$post_obj->post_date_gmt= get_gmt_from_date($datetime);
		 */
		}
	}
}
add_action( 'save_post', 'bv_thumbnailmeta_postmeta', 10, 2 );

function bv_get_nghbpost_geom($get_value=false,$current_post,$previous=true,$arr_slugs=array(), $excluded_terms = '', $taxonomy = 'category'){
	$current_point= $current_post->geom_point;	
	if (empty($current_point)) return;
	$ref_post=$current_post;
	while ( !empty($adjacent_post=bv_get_adjacent_post($ref_post,$previous,$arr_slugs,$excluded_terms,$taxonomy)) ){
		$adjacent_point=$adjacent_post->geom_point ;
		if (!empty($adjacent_point) && !WP_GeoUtil::st_equals($current_point, $adjacent_point)) break;
		$ref_post = $adjacent_post; // look further until there is non-empty geom_point
	}
	if ($get_value){
		return($adjacent_point??NULL);
	}else{
		return($adjacent_post??NULL);
	}	
}

function bv_update_bezierpts($post_obj,$g1, $g2,$term_id=0,$metawrite=false,$smoothfactor=3){
	if ($term_id == 0) return;
	if (empty($g1) || empty($g2) ) return;
	$current_point=$post_obj-> geom_point;
	if (empty($current_point)) return;

	$metakey_cat='geom_bezierpts__' . strval($term_id);

	//$bezierpts = $post_obj -> geom_bezierpts;
	$bezierpts = get_post_meta($post_obj-> ID, $metakey_cat, true);

	if ( strtoupper( WP_GeoUtil::st_geometrytype($g1) )== 'LINESTRING' && strtoupper( WP_GeoUtil::st_geometrytype($g2) )== 'LINESTRING' ){
		$bezierpts_new=WP_Geoutil::wp_bevier_ctrlpts( WP_GeoUtil::startpoint($g1) ,$current_point, WP_GeoUtil::endpoint($g2),$smoothfactor);
		//error_log(print_r('bezier results: '.$bezierpts_new,true));
	}else{
		if ($metawrite) delete_post_meta($post_obj-> ID,$metakey_cat);
		return;
	}

	if ( empty($bezierpts) || !WP_GeoUtil::st_equals($bezierpts, $bezierpts_new)){
		if ($metawrite) update_post_meta($post_obj-> ID, $metakey_cat,$bezierpts_new);
		return $bezierpts_new;
	}
}


function bv_update_gline2($current_post,$where=0,$term_id=0, $excluded_terms = '', $taxonomy = 'category'){
	if ($term_id == 0) return;
	$metakey_cat='geom_line2__'. strval($term_id) ;
	$current_point= $current_post->geom_point;	
	if (empty($current_point)) return;

	$geom_line=get_post_meta($current_post->ID,  $metakey_cat , true);

	$startpoint= WP_GeoUtil::st_startpoint($geom_line)??$current_point;
	$endpoint = WP_GeoUtil::st_endpoint($geom_line)??$current_point;

	$previous_point = $where>0?$startpoint:bv_get_nghbpost_geom(true,$current_post,true,array($term_id),$excluded_terms,$taxonomy)??$current_point;
	$next_point = $where<0?$endpoint:bv_get_nghbpost_geom(true,$current_post,false,array($term_id),$excluded_terms,$taxonomy)??$current_point;

	$geom_line_new= WP_GeoUtil::linestring( $previous_point, $current_point, $next_point) ;
	if( empty($geom_line) || !WP_GeoUtil::st_equals($geom_line,$geom_line_new)  ){
		update_post_meta($current_post->ID, $metakey_cat , $geom_line_new);
	}
	return $geom_line_new;
}

function bv_update_catline($current_id,$updatecurrent=NULL){
	$special_categories_local=$GLOBALS['special_categories'];  
	$current_post=get_post($current_id);
	if ($current_post->post_type != 'post') return false;
	if (empty($current_post->geom_point)) return false;
	$excluded_terms='';
	$taxonomy='category';
	$categories=get_the_category($current_id);
	$arr_ids=array();
	foreach($categories as $cat){
		if (!in_array($cat,$special_categories_local) ) $arr_ids[]=$cat->term_id;	
	}
	foreach($arr_ids as $term_id){
		$previous_post=bv_get_nghbpost_geom(false,$current_post,true,array($term_id),$excluded_terms,$taxonomy);
		if ( !empty($previous_post) ){
			$resultforth=(bv_update_gline2($previous_post,1,$term_id,$excluded_terms,$taxonomy));
		}

		// update source-path of next post
		$next_post=bv_get_nghbpost_geom(false,$current_post,false,array($term_id),$excluded_terms,$taxonomy);
		if ( !empty($next_post) ){
			$resultback=(bv_update_gline2($next_post,-1,$term_id,$excluded_terms,$taxonomy));
		}
		$result = $updatecurrent?(bv_update_gline2($current_post,0,$term_id, $excluded_terms, $taxonomy)):NULL;
	}
	return $arr_ids;
}

add_action( 'save_post', 'bv_update_catline',20 ,2 );
add_action( 'deleted_post', 'bv_update_catline');
add_action( 'trashed_post', 'bv_update_catline');

function bv_update_line1($current_post,$previous=true,$term_id=0, $excluded_terms = '', $taxonomy = 'category'){
	if ($term_id == 0) return;
	$current_point= $current_post->geom_point;	
	if (empty($current_point)) return;

	$metakey_cat='geom_line1'. ($previous?'back__':'forth__'). strval($term_id) ;

	$geom_line=get_post_meta($current_post->ID,  $metakey_cat , true);
	//$line_endnode=$previous? WP_GeoUtil::startpoint($geom_line) : WP_GeoUtil::endpoint($geom_line);
	$adjacent_point = bv_get_nghbpost_geom(true,$current_post,$previous,array($term_id),$excluded_terms,$taxonomy);

	if (empty($adjacent_point)){
		delete_post_meta( $current_post->ID , $metakey_cat);
		return $current_point;
	}else{ 
		$geom_line_new=$previous? WP_GeoUtil::linestring( $adjacent_point, $current_point) : WP_GeoUtil::linestring( $current_point, $adjacent_point) ;
		if( empty($geom_line) || !WP_GeoUtil::st_equals($geom_line,$geom_line_new)  ){
			update_post_meta($current_post->ID, $metakey_cat , $geom_line_new);
		}
		return $geom_line_new;
	}
}

