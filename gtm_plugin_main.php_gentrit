function cd_meta_box_cb()  
{  
	$post_id = get_the_ID( );
	$attachments = get_attached_media('image', $post_id); // Get image attachment(s) to the current Post
	$tag_list= array();
	foreach($attachments as $att){
		foreach(get_the_tags( $att->ID ) as $tag){
			if(!in_array($tag->name, $tag_list)){
				array_push($tag_list, $tag->name);
			}
		}
	}
	echo '<ul>';
	foreach($tag_list as $tag){
		echo "<li class='tag-list-item'><input type='checkbox' name='tags' value='$tag' id='checkbox_$tag'><label for='checkbox_$tag'>$tag<span>x</span><br></label></li>";  
	}
	echo '</ul>';
	echo 'What you put here, show\'s up in the meta box';     
}  
